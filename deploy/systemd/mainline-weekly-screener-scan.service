[Unit]
Description=Main Line Trades Weekly Screener scan batch (watchlist only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jason
WorkingDirectory=/home/jason/main-line-trades-replays
ExecStart=/usr/bin/flock -n /home/jason/main-line-trades-replays/data/weekly_screener_scan.lock /home/jason/main-line-trades-replays/.venv/bin/python /home/jason/main-line-trades-replays/scripts/weekly_screener.py --scan
